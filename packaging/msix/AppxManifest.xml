<?xml version="1.0" encoding="utf-8"?>
<!-- Template: tools/build-release.ps1 fills {Name}, {Publisher}, {PublisherDisplayName}, {Version} and {Arch}. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
IgnorableNamespaces="uap desktop rescap">
  <Identity Name="{Name}" Publisher="{Publisher}" Version="{Version}" ProcessorArchitecture="{Arch}" />
  <Properties>
    <DisplayName>ConnectionClue</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Finds where connection problems happen on this PC's path to the internet and what to try.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
    <Resource Language="hi" />
    <Resource Language="es" />
    <Resource Language="ar" />
    <Resource Language="fr" />
    <Resource Language="bn" />
    <Resource Language="pt" />
    <Resource Language="ru" />
    <Resource Language="id" />
    <Resource Language="ur" />
    <Resource Language="de" />
    <Resource Language="ja" />
    <Resource Language="mr" />
    <Resource Language="vi" />
    <Resource Language="te" />
    <Resource Language="ha-Latn-NG" />
    <Resource Language="tr" />
    <Resource Language="ta" />
  </Resources>
  <Applications>
    <Application Id="ConnectionClue" Executable="ConnectionClue.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="ConnectionClue"
                          Description="Finds where connection problems happen and what to try."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="ConnectionClue.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ConnectionClueStartup" Enabled="false" DisplayName="ConnectionClue" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Full-trust desktop app; Wi-Fi scanning is available only after the user requests it in Insights. -->
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="wiFiControl" />
  </Capabilities>
</Package>
