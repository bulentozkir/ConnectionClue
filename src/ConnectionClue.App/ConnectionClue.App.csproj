<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the notification-area icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ConnectionClue</AssemblyName>
    <Product>ConnectionClue</Product>
    <AssemblyTitle>ConnectionClue</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ship framework resources only for the 20 UI languages. -->
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant;hi;es;ar;fr;bn;pt;ru;id;ur;de;ja;mr;vi;te;ha;tr;ta</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\ConnectionClue.ico</ApplicationIcon>
    <!-- WPF0001: Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- A tray app that checks every minute: no background GC thread, and no profile-guided re-JIT of code that runs rarely. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.Main is the entry point: it checks for a running copy before WPF starts anything. App.xaml is therefore a page, so
         no second Main is generated that would start the app without that check. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Fluent theme would put a Mica backdrop behind every window: more work for the desktop compositor (the GPU) for a
         window that is a plain panel. Off, the window paints its own theme background. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\helpme.md" LogicalName="ConnectionClue.App.helpme.md" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\*.png" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\ConnectionClue.Presentation\ConnectionClue.Presentation.csproj" />
    <ProjectReference Include="..\ConnectionClue.Windows\ConnectionClue.Windows.csproj" />
  </ItemGroup>
</Project>
