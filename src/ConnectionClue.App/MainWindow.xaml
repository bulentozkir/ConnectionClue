                                                <TextBlock Text="{Binding Day}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Checks}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Quality}" ToolTip="{Binding DataContext[History_QualityHelp], ElementName=Root}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Speeds}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Target_Heading]}" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{Binding [Target_Help]}" Style="{StaticResource Secondary}" Margin="0,3,0,6" TextWrapping="Wrap"
