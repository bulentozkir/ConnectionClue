                                </Button>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding OpenLocationSettingsCommand}" HorizontalAlignment="Left"
                                        AutomationProperties.Name="{Binding [Diagnostics_OpenLocation]}"
