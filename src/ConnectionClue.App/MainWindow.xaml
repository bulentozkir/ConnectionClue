                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,5"
                                                AutomationProperties.Name="{Binding AccessibleText}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Time}" Width="180" />
