                                                        MinHeight="28"
                                                        VerticalContentAlignment="Center"
                                                        Text="{Binding Settings.PlanUploadText, UpdateSourceTrigger=PropertyChanged}"
                                                        AutomationProperties.Name="{Binding [Settings_PlanUpload]}"
                                                        AutomationProperties.HelpText="{Binding [Settings_PlanSpeedHint]}" />
                                                    <TextBlock
                                                        Text="Mbps"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center" />
                                                </DockPanel>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock
                                            Text="{Binding [Settings_InvalidPlanSpeed]}"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Visibility="{Binding Settings.IsPlanSpeedInvalid, Converter={StaticResource Shown}}"
                                            AutomationProperties.LiveSetting="Assertive"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2">
                                <TextBlock
                                    Text="{Binding [Settings_Targets]}"
                                    Style="{StaticResource SettingsSection}"
                                    Margin="0,0,0,4"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [Settings_TargetsCompactHint]}"
                                            Style="{StaticResource Caption}"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,6" />
                                        <TextBlock
                                            Text="{Binding [Symptom_Gaming]}"
                                            Style="{StaticResource FieldLabel}" />
                                        <TextBox
                                            MinHeight="28"
                                            VerticalContentAlignment="Center"
                                            Margin="0,2,0,5"
                                            Text="{Binding Settings.GamingTarget, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{Binding [Symptom_Gaming]}"
                                            AutomationProperties.HelpText="{Binding [Settings_TargetsHint]}"
                                            ToolTip="{Binding [Settings_TargetsHint]}"
                                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                                        <TextBlock
                                            Text="{Binding [Symptom_Video]}"
                                            Style="{StaticResource FieldLabel}" />
                                        <TextBox
                                            MinHeight="28"
                                            VerticalContentAlignment="Center"
                                            Margin="0,2,0,5"
                                            Text="{Binding Settings.VideoTarget, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{Binding [Symptom_Video]}"
                                            AutomationProperties.HelpText="{Binding [Settings_TargetsHint]}"
                                            ToolTip="{Binding [Settings_TargetsHint]}"
                                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                                        <TextBlock
                                            Text="{Binding [Symptom_Calls]}"
                                            Style="{StaticResource FieldLabel}" />
                                        <TextBox
                                            MinHeight="28"
                                            VerticalContentAlignment="Center"
                                            Margin="0,2,0,5"
                                            Text="{Binding Settings.CallsTarget, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{Binding [Symptom_Calls]}"
                                            AutomationProperties.HelpText="{Binding [Settings_TargetsHint]}"
                                            ToolTip="{Binding [Settings_TargetsHint]}"
                                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                                        <TextBlock
                                            Text="{Binding [Symptom_Disconnects]}"
                                            Style="{StaticResource FieldLabel}" />
                                        <TextBox
                                            MinHeight="28"
                                            VerticalContentAlignment="Center"
                                            Margin="0,2,0,0"
                                            Text="{Binding Settings.DisconnectTarget, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{Binding [Symptom_Disconnects]}"
                                            AutomationProperties.HelpText="{Binding [Settings_TargetsHint]}"
                                            ToolTip="{Binding [Settings_TargetsHint]}"
                                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem
                    x:Name="PreferencesSettingsTab"
                    Header="{Binding [Settings_TabPreferences]}"
                    Style="{StaticResource SettingsTab}"
                    AutomationProperties.Name="{Binding [Settings_TabPreferences]}"
                    AutomationProperties.HelpText="{Binding [ButtonHelp_SettingsPreferences]}">
                    <ScrollViewer
                        x:Name="PreferencesSettingsTabScroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        FontWeight="Normal"
                        Focusable="False">
                        <Grid
                            Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="12" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0">
                                <TextBlock
                                    Text="{Binding [Settings_SectionAppearance]}"
                                    Style="{StaticResource SettingsSection}"
                                    Margin="0,0,0,4"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <ComboBox
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource SettingsCombo}"
                                            ItemsSource="{Binding Settings.Themes}"
                                            DisplayMemberPath="Label"
                                            SelectedValuePath="Value"
                                            SelectedValue="{Binding Settings.Theme}"
                                            AutomationProperties.Name="{Binding [Settings_Theme]}"
                                            AutomationProperties.HelpText="{Binding [Settings_ThemeHint]}" />
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                            <TextBlock
                                                Text="{Binding [Settings_Theme]}"
                                                Style="{StaticResource SettingLabel}" />
                                            <TextBlock
                                                Text="{Binding [Settings_ThemeHint]}"
                                                Style="{StaticResource Caption}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding [Settings_ThemeWindowsHc]}"
                                                Style="{StaticResource Caption}"
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold"
                                                Visibility="{Binding Settings.WindowsHighContrast, Converter={StaticResource Shown}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <ComboBox
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource SettingsCombo}"
                                            ItemsSource="{Binding Languages}"
                                            DisplayMemberPath="NativeName"
                                            SelectedValuePath="Name"
                                            SelectedValue="{Binding CurrentLanguage}"
                                            IsEnabled="{Binding CanChangeLanguage}"
                                            AutomationProperties.Name="{Binding [Settings_Language]}" />
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                            <TextBlock
                                                Text="{Binding [Settings_Language]}"
                                                Style="{StaticResource SettingLabel}" />
                                            <TextBlock
                                                Text="{Binding [Settings_LanguageRestart]}"
                                                Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock
                                    Text="{Binding [Settings_Shortcuts]}"
                                    Style="{StaticResource SettingsSection}"
                                    Margin="0,8,0,4"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [Settings_ShortcutCheck]}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding [Settings_ShortcutMarker]}"
                                            TextWrapping="Wrap"
                                            Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Text="{Binding LastCheckText}"
                                    Style="{StaticResource Caption}"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding LastCheckText, Converter={StaticResource HasText}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2">
                                <TextBlock
                                    Text="{Binding [Action_Recommendations]}"
                                    Style="{StaticResource SettingsSection}"
                                    Margin="0,0,0,4"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <CheckBox
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ToggleSwitch}"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.AiReview}"
                                            AutomationProperties.Name="{Binding [Settings_AiReview]}"
                                            AutomationProperties.HelpText="{Binding [Settings_AiReviewHint]}" />
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                            <TextBlock
                                                Text="{Binding [Settings_AiReview]}"
                                                Style="{StaticResource SettingLabel}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding [Settings_AiReviewHint]}"
                                                Style="{StaticResource Caption}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock
                                    Text="{Binding [History_SettingsSection]}"
                                    Style="{StaticResource SettingsSection}"
                                    Margin="0,8,0,4"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <Border
                                    Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding HistoryCountText}"
                                            Style="{StaticResource Caption}"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,6" />
                                        <Button
                                            Style="{StaticResource NeutralButton}"
                                            Command="{Binding ClearHistoryCommand}"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding [History_ClearButton]}"
                                            AutomationProperties.HelpText="{Binding HistoryCountText}"
                                            ToolTip="{Binding HistoryCountText}"
                                            Visibility="{Binding IsConfirmingClearHistory, Converter={StaticResource Hidden}}">
                                            <StackPanel
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    Style="{StaticResource Glyph}"
                                                    Text="" />
                                                <TextBlock
                                                    Text="{Binding [History_ClearButton]}"
                                                    Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Clearing cannot be undone, so it asks once more; the question is announced. -->
                                        <StackPanel
                                            Visibility="{Binding IsConfirmingClearHistory, Converter={StaticResource Shown}}">
                                            <TextBlock
                                                Text="{Binding ClearHistoryConfirmText}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,6"
                                                AutomationProperties.LiveSetting="Assertive" />
                                            <WrapPanel>
                                                <Button
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding ConfirmClearHistoryCommand}"
                                                    AutomationProperties.Name="{Binding [History_ClearConfirmButton]}"
                                                    AutomationProperties.HelpText="{Binding ClearHistoryConfirmText}">
                                                    <StackPanel
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            Style="{StaticResource Glyph}"
                                                            Text="" />
                                                        <TextBlock
                                                            Text="{Binding [History_ClearConfirmButton]}"
                                                            Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Style="{StaticResource NeutralButton}"
                                                    Command="{Binding CancelClearHistoryCommand}"
                                                    AutomationProperties.Name="{Binding [History_ClearCancel]}"
                                                    AutomationProperties.HelpText="{Binding [ButtonHelp_CancelClearHistory]}">
                                                    <TextBlock
                                                        Text="{Binding [History_ClearCancel]}" />
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding HistoryClearStatus}"
                                            Style="{StaticResource Secondary}"
                                            FontWeight="SemiBold"
                                            AutomationProperties.LiveSetting="Polite"
                                            Visibility="{Binding HistoryClearStatus, Converter={StaticResource HasText}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
